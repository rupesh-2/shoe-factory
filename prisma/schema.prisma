// Shoe Factory Management System — data model
// Domains: Inventory, Customers, Staff, Finance

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Inventory ----------

model Supplier {
  id        String        @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  materials      RawMaterial[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
}

model RawMaterial {
  id           String          @id @default(cuid())
  name         String
  unit         String          @default("unit") // kg, m, pair, roll...
  quantity     Float           @default(0)
  unitCost     Float           @default(0)
  reorderLevel Float           @default(0)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  supplierId   String?
  movements     StockMovement[]
  bomItems      BomItem[]
  purchaseLines PurchaseLine[]
  createdAt     DateTime        @default(now())
}

model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  model        String?
  size         String?
  color        String?
  price        Float           @default(0)
  cost         Float           @default(0)
  quantity     Int             @default(0)
  reorderLevel Int             @default(0)
  category     Category?       @relation(fields: [categoryId], references: [id])
  categoryId   String?
  movements    StockMovement[]
  orderLines   OrderLine[]
  bom          BomItem[]
  batches      ProductionBatch[]
  outputs      ProductionLog[]
  createdAt    DateTime          @default(now())
}

model StockMovement {
  id            String       @id @default(cuid())
  type          String // IN, OUT, ADJUST
  quantity      Float
  reason        String?
  product       Product?     @relation(fields: [productId], references: [id])
  productId     String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId String?
  createdAt     DateTime     @default(now())
}

// ---------- Customers ----------

model Customer {
  id        String   @id @default(cuid())
  name      String
  company   String?
  type      String   @default("retail") // retail, wholesale
  phone     String?
  email     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  customer   Customer    @relation(fields: [customerId], references: [id])
  customerId String
  status     String      @default("Draft") // Draft, Confirmed, In Production, Shipped, Delivered, Closed
  lines      OrderLine[]
  invoice    Invoice?
  batches    ProductionBatch[]
  notes      String?
  createdAt  DateTime    @default(now())
}

model OrderLine {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  unitPrice Float   @default(0)
}

// ---------- Staff ----------

model Employee {
  id         String       @id @default(cuid())
  name       String
  role       String       @default("Worker")
  department String?
  phone      String?
  email      String?
  payType    String       @default("Daily") // Daily (wageRate × days) or Piece (pairs × category piece rate)
  wageRate   Float        @default(0) // per day
  joinDate   DateTime     @default(now())
  active     Boolean      @default(true)
  attendance Attendance[]
  payrolls   PayrollRun[]
  outputs    ProductionLog[]
}

model Attendance {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime @default(now())
  status     String   @default("Present") // Present, Half Day, Absent, Leave
  hours      Float    @default(8)

  @@unique([employeeId, date])
}

// ---------- Finance ----------

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  order     Order?    @relation(fields: [orderId], references: [id])
  orderId   String?   @unique
  amount    Float     @default(0)
  status    String    @default("Unpaid") // Unpaid, Partial, Paid
  dueDate   DateTime?
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  amount    Float
  method    String   @default("Cash")
  createdAt DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  category  String   @default("Overhead") // Materials, Wages, Utilities, Overhead
  amount    Float
  note      String?
  date      DateTime @default(now())
}

// ---------- Production ----------

// Materials needed to make ONE pair of a product
model BomItem {
  id            String      @id @default(cuid())
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  rawMaterialId String
  quantity      Float       @default(0)

  @@unique([productId, rawMaterialId])
}

model ProductionBatch {
  id           String    @id @default(cuid())
  number       String    @unique
  product      Product   @relation(fields: [productId], references: [id])
  productId    String
  quantity     Int       @default(0)
  status       String    @default("Planned") // Planned, In Progress, Completed, Cancelled
  order        Order?    @relation(fields: [orderId], references: [id])
  orderId      String?
  materialCost Float     @default(0) // cost of materials consumed when started
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
}

// ---------- Purchasing ----------

model PurchaseOrder {
  id         String         @id @default(cuid())
  number     String         @unique
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  supplierId String
  status     String         @default("Ordered") // Ordered, Received, Cancelled
  lines      PurchaseLine[]
  notes      String?
  receivedAt DateTime?
  createdAt  DateTime       @default(now())
}

model PurchaseLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  rawMaterialId   String
  quantity        Float         @default(0)
  unitCost        Float         @default(0)
}

// ---------- Payroll ----------

model PayrollRun {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  month      String // YYYY-MM
  daysWorked Float    @default(0)
  amount     Float    @default(0)
  paidAt     DateTime @default(now())

  @@unique([employeeId, month])
}

// ---------- Piece-rate work ----------

// Shoe type (Sneaker, Boot, Sandal…) with the fixed amount paid to a worker per pair made
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  pieceRate Float     @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

// Pairs a worker made on a day. Rate is copied at entry so later rate changes don't alter past pay.
model ProductionLog {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  date       DateTime
  quantity   Int
  rate       Float
  amount     Float
  createdAt  DateTime @default(now())

  @@index([date])
}
